msgstr ""

#: includes/class-power-coupons-config-ability.php:620
msgid "Delete coupon"
msgstr ""

#: includes/class-power-coupons-config-ability.php:621
msgid "Moves a coupon to trash or permanently deletes it by ID."
msgstr ""

#: includes/class-power-coupons-config-ability.php:680
msgid "Toggle auto-apply"
msgstr ""

#: includes/class-power-coupons-config-ability.php:681
msgid "Enables or disables auto-apply on a coupon. When enabled, the coupon is automatically applied to qualifying carts."
msgstr ""

#: includes/class-power-coupons-config-ability.php:739
msgid "Get coupon shortcode"
msgstr ""

#: includes/class-power-coupons-config-ability.php:740
