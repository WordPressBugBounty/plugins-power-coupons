msgstr ""

#: includes/class-power-coupons-config-ability.php:788
msgid "Get coupon rules"
msgstr ""

#: includes/class-power-coupons-config-ability.php:789
msgid "Returns the conditional rule groups for a coupon. Rules use OR logic between groups and AND logic within each group. Rule types: cart_total, cart_items, products, product_categories."
msgstr ""

#: includes/class-power-coupons-config-ability.php:874
msgid "Set coupon rules"
msgstr ""

#: includes/class-power-coupons-config-ability.php:875
msgid "Sets or replaces all conditional rule groups on a coupon. Groups use OR logic between them, AND logic within. Automatically enables rules. Valid types: cart_total, cart_items, products, product_categories."
msgstr ""

#: includes/class-power-coupons-config-ability.php:960
msgid "Toggle coupon rules"
msgstr ""

#: includes/class-power-coupons-config-ability.php:961
msgid "Enables or disables conditional rules on a coupon without modifying the rules themselves."
msgstr ""

#: includes/class-power-coupons-config-ability.php:1019
msgid "Validate coupon rules"
msgstr ""

#: includes/class-power-coupons-config-ability.php:1020
msgid "Checks whether a coupon's conditional rules are satisfied for the current cart state. Returns pass/fail for each rule group and individual rule. Requires an active WooCommerce cart session."
msgstr ""

